# Foreman environment - copy to .env.local and fill in (or use `op run`).
# Values shown as op:// references resolve via the 1Password CLI:
#   op run --env-file .env.local -- npm run dev
# .env.local is gitignored. Never commit real keys.

# Anthropic (agent loop)
ANTHROPIC_API_KEY=op://Personal/Anthropic/credential

# Neon serverless Postgres - server-side only. Use the POOLED connection string
# (host contains "-pooler"). All DB access goes through this.
DATABASE_URL=op://Personal/Foreman-Neon/connection_string

# Brave Search API - the researcher agent's web_search tool.
# Free plan: https://brave.com/search/api/ (1 query/sec, ~2k/month).
BRAVE_API_KEY=op://Personal/Foreman-Brave/credential

# Access gate for PAID endpoints (run/approve/eval). Set this in production so
# only you can spend the Anthropic budget; the UI prompts for it once and the
# site stays publicly browsable (read-only). Leave UNSET locally (open).
# FOREMAN_OPERATOR_KEY=some-long-random-string
